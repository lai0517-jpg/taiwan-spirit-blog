---
import { getCollection } from 'astro:content';
import QuickNav from './QuickNav.astro';
import { fieldNotePlaces, getFieldNotesByRegion } from '../data/fieldNotes';
import { taiwanSpiritRegions, regionMatches, findRegionBySlug } from '../data/regions';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 動態彙整主題與子分類結構
// theme 來自檔案 path 的子目錄名稱 (例如: blog/plants/xxx.md -> theme 為 plants)
const navigationData: Record<string, Set<string>> = {};

// 主題中文對照表
const themeNames: Record<string, string> = {
  fuzhe: '福澤系統',
  plants: '植物・作物',
  monsters: '精怪・地景',
  talismans: '符咒・法器',
  temples: '廟宇神靈'
};

allPosts.forEach((post) => {
  const parts = post.slug.split('/');
  if (parts.length > 1) {
    const theme = parts[0];
    const category = post.data.category;
    if (!navigationData[theme]) {
      navigationData[theme] = new Set();
    }
    navigationData[theme].add(category);
  }
});

const themes = Object.keys(navigationData).sort();

const regionCounts = taiwanSpiritRegions.map((region) => ({
  ...region,
  count: allPosts.filter((post) =>
    post.data.regions?.some((postRegion) => regionMatches(region, postRegion))
  ).length,
}));

const regionPathMatch = Astro.url.pathname.match(/\/regions\/([^/]+)/);
const currentRegionSlug = regionPathMatch?.[1] ?? '';
const currentFieldNotes = currentRegionSlug ? getFieldNotesByRegion(currentRegionSlug) : [];

const fieldNoteLinks = fieldNotePlaces.map((place) => {
  const primaryRegion = findRegionBySlug(place.regionSlugs[0]);
  return {
    ...place,
    primaryRegion,
    count: place.sections.reduce((total, section) => total + section.entries.length, 0),
  };
});
---

<aside class="sidebar">
  <div class="brand">
    <a href="/taiwan-spirit-blog/">
      <div class="brand-title">台灣靈格</div>
      <span class="brand-subtitle">TAIWAN SPIRIT LOG</span>
    </a>
  </div>

  <QuickNav variant="sidebar" />

  <nav class="field-home-nav" aria-label="田野資料入口">
    <a href="/taiwan-spirit-blog/field-notes/" class="field-home-link">
      <span>地方田野資料</span>
      <span>Field Notes</span>
    </a>
  </nav>

  <nav class="region-nav" aria-label="地區快選與田野分類">
    <div class="region-nav-title">地區｜Regions</div>
    <a href="/taiwan-spirit-blog/regions/" class="region-all-link">全部地區索引</a>

    <details class="region-subgroup" open>
      <summary>田野地區分類</summary>
      <div class="region-link-list">
        {fieldNoteLinks.map((place) => (
          <a href={`/taiwan-spirit-blog/regions/${place.primaryRegion?.slug}/#field-notes`} class="region-link field-place-link">
            <span>{place.title}</span>
            <span class="region-link-count">{place.count}</span>
          </a>
        ))}
      </div>
    </details>

    <details class="region-subgroup" open>
      <summary>靈格分區</summary>
      <div class="region-link-list">
        {regionCounts.map((region) => (
          <a href={`/taiwan-spirit-blog/regions/${region.slug}`} class="region-link">
            <span>{region.shortTitle}</span>
            <span class="region-link-count">{region.count}</span>
          </a>
        ))}
      </div>
    </details>
  </nav>

  {currentFieldNotes.length > 0 && (
    <nav class="field-category-nav" aria-label="田野資料分類快選">
      <div class="region-nav-title">田野分類｜Field Categories</div>
      {currentFieldNotes.map((place) => (
        <details class="field-category-group" open>
          <summary>{place.title}</summary>
          <ul class="field-category-list">
            {place.sections.map((section, index) => (
              <li>
                <a href={`#field-${place.slug}-${index}`} class="field-category-link">
                  <span>{section.title}</span>
                  <span>{section.entries.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </nav>
  )}
  
  <nav class="nav-tree">
    {themes.map((theme) => (
      <details class="theme-group" open>
        <summary class="theme-summary">
          <span class="gold-bullet">✦</span>
          {themeNames[theme] || theme}
        </summary>
        <ul class="category-list">
          <li>
            <a href={`/taiwan-spirit-blog/${theme}`} class="category-link all-link">
              全部條目
            </a>
          </li>
          {Array.from(navigationData[theme]).sort().map((category) => (
            <li>
              <a 
                href={`/taiwan-spirit-blog/${theme}?category=${encodeURIComponent(category)}`} 
                class="category-link"
              >
                {category}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    width: 280px;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    padding: 2rem 1.5rem;
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .brand {
    margin-bottom: 2rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-gold);
    letter-spacing: 2px;
  }
  .brand-subtitle {
    font-family: var(--font-cinzel);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 3px;
  }
  .nav-tree {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .field-home-nav {
    border-bottom: 1px dashed rgba(216, 182, 109, 0.14);
    margin-bottom: 1.35rem;
    padding-bottom: 1.15rem;
  }
  .field-home-link {
    display: grid;
    gap: 0.1rem;
    border: 1px solid rgba(216, 182, 109, 0.2);
    border-radius: 4px;
    background-color: rgba(216, 182, 109, 0.08);
    padding: 0.65rem 0.7rem;
  }
  .field-home-link span:first-child {
    color: var(--color-gold-bright);
    font-size: 0.92rem;
  }
  .field-home-link span:last-child {
    color: var(--color-text-muted);
    font-family: var(--font-cinzel);
    font-size: 0.68rem;
    letter-spacing: 1px;
  }
  .region-nav {
    border-bottom: 1px dashed rgba(216, 182, 109, 0.14);
    margin-bottom: 1.35rem;
    padding-bottom: 1.15rem;
  }
  .region-nav-title {
    font-family: var(--font-cinzel);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }
  .region-all-link {
    display: block;
    color: var(--color-gold);
    font-size: 0.9rem;
    margin-bottom: 0.55rem;
  }
  .region-subgroup {
    border: 1px solid rgba(216, 182, 109, 0.1);
    border-radius: 3px;
    background-color: rgba(216, 182, 109, 0.025);
    margin-top: 0.55rem;
    padding: 0.45rem;
  }
  .region-subgroup summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-gold);
    font-size: 0.84rem;
    margin-bottom: 0.4rem;
  }
  .region-subgroup summary::-webkit-details-marker {
    display: none;
  }
  .region-link-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .region-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid rgba(216, 182, 109, 0.1);
    border-radius: 3px;
    color: var(--color-text-muted);
    background-color: rgba(216, 182, 109, 0.035);
    padding: 0.35rem 0.45rem;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .region-link:hover {
    color: var(--color-gold-bright);
    border-color: rgba(216, 182, 109, 0.32);
  }
  .field-place-link {
    background-color: rgba(216, 182, 109, 0.08);
    border-color: rgba(216, 182, 109, 0.18);
    color: var(--color-gold-bright);
  }
  .region-link-count {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-family: var(--font-cinzel);
    font-size: 0.78rem;
  }
  .field-category-nav {
    border-bottom: 1px dashed rgba(216, 182, 109, 0.14);
    margin-bottom: 1.35rem;
    padding-bottom: 1.15rem;
  }
  .field-category-group {
    border: 1px solid rgba(216, 182, 109, 0.1);
    border-radius: 3px;
    background-color: rgba(216, 182, 109, 0.03);
    margin-bottom: 0.45rem;
  }
  .field-category-group summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-gold);
    font-size: 0.88rem;
    padding: 0.45rem 0.5rem;
  }
  .field-category-group summary::-webkit-details-marker {
    display: none;
  }
  .field-category-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px dashed rgba(216, 182, 109, 0.1);
    padding: 0.4rem 0.45rem 0.5rem;
  }
  .field-category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.35;
    padding: 0.18rem 0;
  }
  .field-category-link:hover {
    color: var(--color-gold-bright);
  }
  .field-category-link span:last-child {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-family: var(--font-cinzel);
    font-size: 0.74rem;
  }
  .theme-group {
    border-bottom: 1px dashed rgba(216, 182, 109, 0.1);
    padding-bottom: 1rem;
  }
  .theme-summary {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-gold);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 1.05rem;
  }
  .theme-summary::-webkit-details-marker {
    display: none;
  }
  .gold-bullet {
    font-size: 0.8rem;
    transition: transform 0.3s;
  }
  .theme-group[open] .gold-bullet {
    transform: rotate(45deg);
  }
  .category-list {
    list-style: none;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .category-link {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    display: block;
    padding: 0.25rem 0;
    transition: color 0.2s;
  }
  .category-link:hover {
    color: var(--color-gold-bright);
  }
  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: -280px; /* 隱藏在左側螢幕外 */
      width: 280px;
      height: 100vh;
      z-index: 1010;
      border-right: 1px solid var(--color-border);
      border-bottom: none;
      box-shadow: 5px 0 25px rgba(0, 0, 0, 0.5);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sidebar.active {
      transform: translateX(280px); /* 滑出顯示 */
    }
    .brand {
      margin-bottom: 1.5rem;
      padding-bottom: 0.8rem;
    }
  }
</style>
