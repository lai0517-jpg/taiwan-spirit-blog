---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { fieldNotePlaces } from '../../data/fieldNotes';
import { findRegionBySlug } from '../../data/regions';

const places = fieldNotePlaces.map((place) => {
  const entryCount = place.sections.reduce((count, section) => count + section.entries.length, 0);
  const primaryRegion = findRegionBySlug(place.regionSlugs[0]);
  return { ...place, entryCount, primaryRegion };
});
---

<BlogLayout title="地方田野資料">
  <header class="page-header">
    <div class="breadcrumb">
      <a href="/taiwan-spirit-blog/">首頁</a> / <span>地方田野資料</span>
    </div>
    <h2 class="section-title">地方田野資料｜Field Notes</h2>
    <p class="section-desc">從參考資料夾整理出的台灣地圖節點。每個節點都已預留圖片、座標與後續文章位置。</p>
  </header>

  <section class="field-grid" aria-label="地方田野節點">
    {places.map((place) => (
      <article class="field-card">
        <div class="field-card-head">
          <div>
            <p class="field-county">{place.county}</p>
            <h3>{place.title}</h3>
            <p class="field-english">{place.englishTitle}</p>
          </div>
          <span>{place.entryCount}</span>
        </div>
        <p class="field-summary">{place.summary}</p>
        <div class="field-links">
          {place.primaryRegion && (
            <a href={`/taiwan-spirit-blog/regions/${place.primaryRegion.slug}/#field-notes`}>
              前往 {place.primaryRegion.shortTitle}
            </a>
          )}
        </div>
        <div class="section-list">
          {place.sections.map((section, index) => (
            <a href={`/taiwan-spirit-blog/regions/${place.primaryRegion?.slug}/#field-${place.slug}-${index}`}>
              <span>{section.title}</span>
              <span>{section.entries.length}</span>
            </a>
          ))}
        </div>
      </article>
    ))}
  </section>
</BlogLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .breadcrumb {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .breadcrumb a:hover {
    color: var(--color-gold);
  }
  .section-title {
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .section-desc {
    color: var(--color-text-muted);
  }
  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }
  .field-card {
    display: grid;
    gap: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 1.1rem;
  }
  .field-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .field-county {
    color: var(--color-gold);
    font-size: 0.82rem;
  }
  .field-card h3 {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }
  .field-english,
  .field-summary {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .field-card-head > span {
    color: var(--color-gold-bright);
    border: 1px solid rgba(216, 182, 109, 0.22);
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
  }
  .field-links a {
    display: inline-flex;
    color: var(--color-gold-bright);
    border: 1px solid rgba(216, 182, 109, 0.2);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    font-size: 0.84rem;
  }
  .section-list {
    display: grid;
    gap: 0.35rem;
  }
  .section-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(216, 182, 109, 0.12);
    border-radius: 3px;
    color: var(--color-text-muted);
    padding: 0.38rem 0.5rem;
    font-size: 0.82rem;
  }
  .section-list a:hover {
    color: var(--color-gold-bright);
    border-color: rgba(216, 182, 109, 0.32);
  }
</style>
