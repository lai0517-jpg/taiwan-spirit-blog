---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {
  getFieldNoteEntryDataStatus,
  getFieldNoteEntryId,
  getFieldNoteEntryImagePath,
  getFieldNoteEntryImageStatus,
  getFieldNotesByRegion,
} from '../../data/fieldNotes';
import { findRegionBySlug, regionMatches, taiwanSpiritRegions } from '../../data/regions';

export function getStaticPaths() {
  return taiwanSpiritRegions.map((region) => ({
    params: { region: region.slug },
  }));
}

const { region: regionSlug } = Astro.params;
const region = findRegionBySlug(regionSlug as string)!;
const fieldNotes = getFieldNotesByRegion(region.slug);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.regions?.some((postRegion) => regionMatches(region, postRegion)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const themeNames: Record<string, string> = {
  fuzhe: '福澤系統',
  plants: '植物・作物',
  monsters: '精怪・地景',
  talismans: '符咒・法器',
  temples: '廟宇神靈',
};

const groupedPosts = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const theme = post.slug.split('/')[0] || 'other';
  if (!groups[theme]) {
    groups[theme] = [];
  }
  groups[theme].push(post);
  return groups;
}, {});

const orderedThemes = Object.keys(groupedPosts).sort((a, b) => {
  const order = ['temples', 'monsters', 'fuzhe', 'plants', 'talismans'];
  return order.indexOf(a) - order.indexOf(b);
});

const getFieldPlaceShortTitle = (title: string) => {
  if (title.endsWith('市') || title.endsWith('縣') || title.endsWith('縣市')) {
    return title;
  }
  return title.replace(/^(苗栗|新北)/, '');
};
---

<BlogLayout title={region.title}>
  <header class="page-header">
    <div class="breadcrumb">
      <a href="/taiwan-spirit-blog/">首頁</a> /
      <a href="/taiwan-spirit-blog/regions/">地區索引</a> /
      <span>{region.shortTitle}</span>
    </div>
    <p class="region-area">{region.area}</p>
    <h2 class="section-title">{region.title}</h2>
    <p class="section-desc">{region.description}</p>
    <div class="county-list">
      {region.counties.map((county) => <span>{county}</span>)}
    </div>
    <div class="place-label-block" aria-label="縣市與地方標示">
      <strong>地名標示｜Places</strong>
      <div class="place-label-list">
        {region.placeLabels.map((place) => <span>{place}</span>)}
      </div>
    </div>
  </header>

  <nav class="theme-jump" aria-label="地區內類別快選">
    <a href="#regional-stories">故事資料</a>
    {fieldNotes.length > 0 && <a href="#field-notes">田野資料 {fieldNotes.length}</a>}
    {fieldNotes.flatMap((place) =>
      place.sections.map((section, index) => (
        <a href={`#field-${place.slug}-${index}`}>{getFieldPlaceShortTitle(place.title)}・{section.title}</a>
      ))
    )}
    {orderedThemes.map((theme) => (
      <a href={`#${theme}`}>{themeNames[theme] ?? theme} {groupedPosts[theme].length}</a>
    ))}
  </nav>

  <section class="region-story-section" id="regional-stories" aria-label="地區故事資料">
    <div class="theme-section-head">
      <h3>地區故事資料｜Regional Stories</h3>
      <span>{region.storyFocus.length} 個重點</span>
    </div>
    <p>{region.storySummary}</p>
    <div class="story-focus-list">
      {region.storyFocus.map((focus) => <span>{focus}</span>)}
    </div>
  </section>

  {fieldNotes.length > 0 && (
    <section class="field-note-section" id="field-notes">
      <div class="theme-section-head">
        <h3>地方田野資料｜Field Notes</h3>
        <span>{fieldNotes.length} 個地圖節點</span>
      </div>
      <div class="field-note-list">
        {fieldNotes.map((place) => (
          <article class="field-note-card">
            <div class="field-note-head">
              <div>
                <p class="field-note-county">{place.county}</p>
                <h4>{place.title}</h4>
                <p class="field-note-english">{place.englishTitle}</p>
              </div>
              <span>{place.sections.reduce((count, section) => count + section.entries.length, 0)} 筆</span>
            </div>
            <p class="field-note-summary">{place.summary}</p>
            <div class="field-note-groups">
              {place.sections.map((section, index) => (
                <details class="field-note-group" id={`field-${place.slug}-${index}`}>
                  <summary>{section.title} <span>{section.entries.length}</span></summary>
                  <div class="field-note-entry-list">
                    {section.entries.map((entry, entryIndex) => {
                      const entryId = getFieldNoteEntryId(place, index, entryIndex);
                      const imagePath = entry.image ?? getFieldNoteEntryImagePath(place, index, entryIndex);
                      const imageStatus = getFieldNoteEntryImageStatus(entry);
                      const dataStatus = getFieldNoteEntryDataStatus(entry);
                      return (
                      <div class="field-note-entry">
                        <div class:list={['field-note-image-slot', imageStatus]}>
                          {entry.image ? (
                            <img src={entry.image} alt={entry.imageAlt ?? entry.title} loading="lazy" />
                          ) : (
                            <div>
                              <span>待生成圖片</span>
                              <code>{imagePath}</code>
                            </div>
                          )}
                        </div>
                        <div class="field-note-entry-top">
                          <strong>{entry.title}</strong>
                          <span class:list={['field-note-badge', entry.status]}>{entry.statusLabel}</span>
                        </div>
                        <p>{entry.summary}</p>
                        <dl class="field-note-meta">
                          <div>
                            <dt>資料 ID</dt>
                            <dd>{entryId}</dd>
                          </div>
                          <div>
                            <dt>圖片</dt>
                            <dd>{imageStatus === 'ready' ? '已完成' : '待生成'}</dd>
                          </div>
                          <div>
                            <dt>資料</dt>
                            <dd>
                              {dataStatus === 'structured' && '已結構化'}
                              {dataStatus === 'needsCoordinates' && '待補座標'}
                              {dataStatus === 'needsArticle' && '待補文章'}
                            </dd>
                          </div>
                          <div>
                            <dt>座標</dt>
                            <dd>{entry.lat && entry.lng ? `${entry.lat}, ${entry.lng}` : '預留'}</dd>
                          </div>
                          <div>
                            <dt>文章</dt>
                            <dd>{entry.relatedPostUrl ? <a href={entry.relatedPostUrl}>已連結</a> : '預留'}</dd>
                          </div>
                        </dl>
                      </div>
                      );
                    })}
                  </div>
                </details>
              ))}
            </div>
            <p class="field-note-source">來源：{place.sourceFile}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {orderedThemes.map((theme) => (
    <section class="theme-section" id={theme}>
      <div class="theme-section-head">
        <h3>{themeNames[theme] ?? theme}</h3>
        <span>{groupedPosts[theme].length} 筆</span>
      </div>
      <div class="posts-grid">
        {groupedPosts[theme].map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
  ))}

  {posts.length === 0 && (
    <div class="empty-state">
      <p>此地區目前尚未串連文章。</p>
    </div>
  )}
</BlogLayout>

<style>
  .page-header {
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.7rem;
  }
  .breadcrumb a:hover {
    color: var(--color-gold);
  }
  .region-area {
    color: var(--color-gold);
    font-size: 0.85rem;
    margin-bottom: 0.2rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }
  .section-desc {
    color: var(--color-text-muted);
    max-width: 860px;
  }
  .county-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .county-list span {
    border: 1px solid rgba(216, 182, 109, 0.14);
    border-radius: 2px;
    color: var(--color-text-muted);
    background-color: rgba(216, 182, 109, 0.04);
    padding: 0.12rem 0.45rem;
    font-size: 0.78rem;
  }
  .place-label-block {
    margin-top: 1rem;
  }
  .place-label-block strong {
    color: var(--color-gold);
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .place-label-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .place-label-list span {
    border: 1px solid rgba(120, 158, 145, 0.24);
    border-radius: 2px;
    color: var(--color-text);
    background-color: rgba(120, 158, 145, 0.08);
    padding: 0.12rem 0.45rem;
    font-size: 0.78rem;
  }
  .theme-jump {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-border);
    background-color: rgba(13, 15, 18, 0.94);
    backdrop-filter: blur(8px);
    padding: 0.7rem 0 0.8rem;
    margin-bottom: 1.6rem;
  }
  .theme-jump a {
    flex: 0 0 auto;
    border: 1px solid rgba(216, 182, 109, 0.16);
    border-radius: 4px;
    color: var(--color-text-muted);
    background-color: rgba(216, 182, 109, 0.05);
    padding: 0.35rem 0.65rem;
    font-size: 0.84rem;
  }
  .theme-jump a:hover {
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
  }
  .theme-section {
    scroll-margin-top: 74px;
    margin-bottom: 2.5rem;
  }
  .region-story-section {
    scroll-margin-top: 74px;
    border: 1px solid rgba(216, 182, 109, 0.16);
    border-radius: 4px;
    background-color: rgba(216, 182, 109, 0.035);
    margin-bottom: 2rem;
    padding: 1.1rem;
  }
  .region-story-section p {
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .story-focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .story-focus-list span {
    border: 1px solid rgba(216, 182, 109, 0.16);
    border-radius: 2px;
    color: var(--color-gold-bright);
    background-color: rgba(216, 182, 109, 0.06);
    padding: 0.14rem 0.45rem;
    font-size: 0.78rem;
  }
  .field-note-section {
    scroll-margin-top: 74px;
    margin-bottom: 2.5rem;
  }
  .theme-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px dashed rgba(216, 182, 109, 0.14);
    padding-bottom: 0.55rem;
  }
  .theme-section-head h3 {
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }
  .theme-section-head span {
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .field-note-list {
    display: grid;
    gap: 1rem;
  }
  .field-note-card {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 1.1rem;
  }
  .field-note-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }
  .field-note-county {
    color: var(--color-gold);
    font-size: 0.82rem;
    margin-bottom: 0.15rem;
  }
  .field-note-head h4 {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }
  .field-note-english {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  .field-note-head > span {
    flex: 0 0 auto;
    color: var(--color-gold-bright);
    border: 1px solid rgba(216, 182, 109, 0.22);
    border-radius: 99px;
    background-color: rgba(216, 182, 109, 0.08);
    padding: 0.18rem 0.55rem;
    font-size: 0.78rem;
  }
  .field-note-summary {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  .field-note-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.7rem;
  }
  .field-note-group {
    scroll-margin-top: 84px;
    border: 1px solid rgba(216, 182, 109, 0.12);
    border-radius: 4px;
    background-color: rgba(216, 182, 109, 0.035);
  }
  .field-note-group summary {
    cursor: pointer;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.75rem;
    font-size: 0.9rem;
  }
  .field-note-group summary span {
    color: var(--color-text-muted);
    font-family: var(--font-cinzel);
    font-size: 0.76rem;
  }
  .field-note-entry-list {
    display: grid;
    gap: 0.55rem;
    border-top: 1px dashed rgba(216, 182, 109, 0.12);
    padding: 0.7rem 0.75rem 0.8rem;
  }
  .field-note-entry {
    border-bottom: 1px dashed rgba(216, 182, 109, 0.1);
    padding-bottom: 0.55rem;
  }
  .field-note-entry:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .field-note-entry-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.55rem;
    margin-bottom: 0.25rem;
  }
  .field-note-image-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 128px;
    border: 1px dashed rgba(216, 182, 109, 0.2);
    border-radius: 4px;
    background-color: rgba(13, 15, 18, 0.45);
    margin-bottom: 0.65rem;
    overflow: hidden;
  }
  .field-note-image-slot img {
    width: 100%;
    height: 100%;
    min-height: 128px;
    object-fit: cover;
  }
  .field-note-image-slot div {
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    padding: 0.75rem;
    text-align: center;
  }
  .field-note-image-slot span {
    color: var(--color-gold);
    font-size: 0.78rem;
  }
  .field-note-image-slot code {
    color: var(--color-text-muted);
    font-family: var(--font-cinzel);
    font-size: 0.62rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .field-note-entry strong {
    color: var(--color-text);
    font-size: 0.86rem;
    line-height: 1.35;
  }
  .field-note-entry p {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .field-note-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
    border-top: 1px dashed rgba(216, 182, 109, 0.1);
    margin-top: 0.55rem;
    padding-top: 0.55rem;
  }
  .field-note-meta div {
    min-width: 0;
  }
  .field-note-meta dt {
    color: var(--color-gold);
    font-size: 0.66rem;
  }
  .field-note-meta dd {
    color: var(--color-text-muted);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }
  .field-note-meta a:hover {
    color: var(--color-gold-bright);
  }
  .field-note-badge {
    flex: 0 0 auto;
    border-radius: 99px;
    padding: 0.12rem 0.38rem;
    font-size: 0.68rem;
    line-height: 1.25;
  }
  .field-note-badge.fact {
    color: #bfe6c9;
    background-color: rgba(65, 151, 96, 0.16);
  }
  .field-note-badge.documented {
    color: #f1d280;
    background-color: rgba(216, 182, 109, 0.13);
  }
  .field-note-badge.oral {
    color: #f3b7a8;
    background-color: rgba(196, 87, 65, 0.16);
  }
  .field-note-badge.rumor {
    color: #c5cedb;
    background-color: rgba(148, 163, 184, 0.14);
  }
  .field-note-source {
    color: var(--color-text-muted);
    border-top: 1px dashed rgba(216, 182, 109, 0.12);
    margin-top: 1rem;
    padding-top: 0.65rem;
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
  }
</style>
