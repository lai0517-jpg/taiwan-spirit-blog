---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getFieldNotesByRegion } from '../../data/fieldNotes';
import { referenceFolders } from '../../data/referenceLibrary';
import { taiwanRegionGroups, taiwanSpiritRegions, regionMatches } from '../../data/regions';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const regionCards = taiwanSpiritRegions.map((region) => {
  const posts = allPosts.filter((post) =>
    post.data.regions?.some((postRegion) => regionMatches(region, postRegion))
  );

  const themeCounts = posts.reduce<Record<string, number>>((counts, post) => {
    const theme = post.slug.split('/')[0] || 'other';
    counts[theme] = (counts[theme] ?? 0) + 1;
    return counts;
  }, {});

  return {
    ...region,
    count: posts.length,
    fieldNotes: getFieldNotesByRegion(region.slug),
    themeCounts,
  };
});

const themeNames: Record<string, string> = {
  fuzhe: '福澤',
  plants: '植物',
  monsters: '精怪',
  talismans: '符物',
  temples: '廟宇',
};

const regionCardMap = new Map(regionCards.map((region) => [region.slug, region]));

const groupedRegionCards = taiwanRegionGroups.map((group) => ({
  ...group,
  regions: group.regionSlugs
    .map((slug) => regionCardMap.get(slug))
    .filter((region): region is (typeof regionCards)[number] => Boolean(region)),
}));
---

<BlogLayout title="地區索引">
  <header class="page-header">
    <div class="breadcrumb">
      <a href="/taiwan-spirit-blog/">首頁</a> / <span>地區索引</span>
    </div>
    <h2 class="section-title">地區索引｜Region Index</h2>
    <p class="section-desc">先用地區串連現有資料；之後台灣地圖與分類篩選都可以接到這一層。</p>
  </header>

  <section class="region-group-list" aria-label="台灣靈格地區">
    {groupedRegionCards.map((group) => (
      <section class="region-group-section" id={`group-${group.id}`}>
        <div class="region-group-head">
          <div>
            <h3>{group.title}</h3>
            <p>{group.englishTitle}</p>
          </div>
          <span>{group.regions.length} 區</span>
        </div>
        <p class="region-group-summary">{group.summary}</p>
        <div class="region-grid">
          {group.regions.map((region) => (
            <a class="region-card" href={`/taiwan-spirit-blog/regions/${region.slug}`}>
              <div class="region-card-head">
                <div>
                  <p class="region-area">{region.area}</p>
                  <h3>{region.title}</h3>
                  <p class="region-english">{region.englishTitle}</p>
                </div>
                <span class="region-count">{region.count}</span>
              </div>
              <p class="region-description">{region.description}</p>
              <p class="region-story">{region.storySummary}</p>
              <div class="story-focus-list" aria-label="故事資料重點">
                {region.storyFocus.slice(0, 5).map((focus) => <span>{focus}</span>)}
              </div>
              <div class="county-list">
                {region.counties.slice(0, 6).map((county) => <span>{county}</span>)}
              </div>
              <div class="place-label-block" aria-label="縣市與地方標示">
                <strong>地名標示｜Places</strong>
                <div class="place-label-list">
                  {region.placeLabels.map((place) => <span>{place}</span>)}
                </div>
              </div>
              {region.fieldNotes.length > 0 && (
                <div class="field-note-list">
                  {region.fieldNotes.map((place) => (
                    <span>{place.title} {place.sections.reduce((count, section) => count + section.entries.length, 0)}</span>
                  ))}
                </div>
              )}
              <div class="theme-list" aria-label="目前資料類型統計">
                {Object.entries(region.themeCounts).map(([theme, count]) => (
                  <span>{themeNames[theme] ?? theme} {count}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>

  <section class="reference-section" aria-label="參考資料夾串連狀態">
    <div class="reference-head">
      <h3>參考資料夾｜Reference Folders</h3>
      <p>這些資料夾已納入專案索引；後續新增資料會從這裡整理成地圖節點、文章資料與圖片清單。</p>
    </div>
    <div class="reference-grid">
      {referenceFolders.map((folder) => (
        <article class="reference-card">
          <div>
            <h4>{folder.title}</h4>
            <p class="reference-english">{folder.englishTitle}</p>
          </div>
          <p>{folder.purpose}</p>
          <code>{folder.path}</code>
          {folder.connectedData && (
            <div class="connected-list">
              {folder.connectedData.map((item) => <span>{item}</span>)}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BlogLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .breadcrumb a:hover {
    color: var(--color-gold);
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }
  .section-desc {
    color: var(--color-text-muted);
  }
  .region-group-list {
    display: grid;
    gap: 1.4rem;
  }
  .region-group-section {
    scroll-margin-top: 76px;
    border-top: 1px solid rgba(216, 182, 109, 0.14);
    padding-top: 1rem;
  }
  .region-group-section:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .region-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }
  .region-group-head h3 {
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }
  .region-group-head p,
  .region-group-head span,
  .region-group-summary {
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }
  .region-group-summary {
    margin-bottom: 0.85rem;
    max-width: 920px;
    line-height: 1.6;
  }
  .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .region-card {
    display: flex;
    min-height: 290px;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 1.15rem;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }
  .region-card:hover {
    border-color: var(--color-gold);
    background-color: var(--color-surface-hover);
    transform: translateY(-2px);
  }
  .region-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .region-area {
    font-size: 0.78rem;
    color: var(--color-gold);
    margin-bottom: 0.2rem;
  }
  .region-card h3 {
    font-family: var(--font-serif);
    color: var(--color-text);
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .region-english {
    color: var(--color-text-muted);
    font-size: 0.76rem;
    margin-top: 0.15rem;
  }
  .region-count {
    flex: 0 0 auto;
    min-width: 42px;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(216, 182, 109, 0.24);
    color: var(--color-gold-bright);
    background-color: rgba(216, 182, 109, 0.08);
    border-radius: 50%;
    font-family: var(--font-cinzel);
  }
  .region-description {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .region-story {
    border-left: 2px solid rgba(216, 182, 109, 0.32);
    color: var(--color-text);
    font-size: 0.84rem;
    line-height: 1.65;
    margin-top: 0.85rem;
    padding-left: 0.65rem;
  }
  .county-list,
  .field-note-list,
  .theme-list,
  .story-focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .story-focus-list {
    margin-top: 0.75rem;
  }
  .county-list {
    margin-top: 1rem;
  }
  .place-label-block {
    margin-top: 0.85rem;
  }
  .place-label-block strong {
    color: var(--color-gold);
    display: block;
    font-size: 0.76rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }
  .place-label-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }
  .field-note-list {
    margin-top: 0.75rem;
  }
  .theme-list {
    margin-top: auto;
    padding-top: 1rem;
  }
  .county-list span,
  .field-note-list span,
  .theme-list span,
  .story-focus-list span {
    border: 1px solid rgba(216, 182, 109, 0.14);
    border-radius: 2px;
    color: var(--color-text-muted);
    background-color: rgba(216, 182, 109, 0.04);
    padding: 0.12rem 0.4rem;
    font-size: 0.76rem;
  }
  .theme-list span {
    color: var(--color-gold);
  }
  .field-note-list span {
    color: var(--color-gold-bright);
    background-color: rgba(216, 182, 109, 0.08);
  }
  .story-focus-list span {
    color: var(--color-text);
    background-color: rgba(216, 182, 109, 0.06);
  }
  .place-label-list span {
    border: 1px solid rgba(120, 158, 145, 0.24);
    border-radius: 2px;
    color: var(--color-text);
    background-color: rgba(120, 158, 145, 0.08);
    padding: 0.12rem 0.4rem;
    font-size: 0.74rem;
  }
  .reference-section {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .reference-head {
    margin-bottom: 1rem;
  }
  .reference-head h3 {
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }
  .reference-head p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .reference-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.85rem;
  }
  .reference-card {
    display: grid;
    gap: 0.55rem;
    border: 1px solid rgba(216, 182, 109, 0.14);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 0.95rem;
  }
  .reference-card h4 {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1rem;
  }
  .reference-english,
  .reference-card p {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .reference-card code {
    color: var(--color-gold);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }
  .connected-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .connected-list span {
    border: 1px solid rgba(216, 182, 109, 0.14);
    border-radius: 2px;
    color: var(--color-text-muted);
    padding: 0.1rem 0.35rem;
    font-size: 0.68rem;
  }
</style>
